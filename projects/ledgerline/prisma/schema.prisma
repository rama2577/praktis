// LedgerLine — Data model (v1)
// Konvensi: snake_case kolom; semua tabel multi-tenant punya firmId (tenant-aware).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  JUNIOR
  SENIOR
  TAX
  PARTNER
}

enum Industry {
  RETAIL
  SERVICES
  FNB
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  // Kategori utama (9 jenis) — PRD v2 M2
  FINANCIAL_STATEMENT
  GENERAL_JOURNAL
  BANK_STATEMENT
  PAYABLES_REPORT
  RECEIVABLES_REPORT
  INVENTORY_REPORT
  PAYROLL_REPORT
  TAX_REPORT
  OTHER
  // F6C — dokumen referensi klien (tidak menghasilkan jurnal)
  LEGAL_DOCUMENT // NIB, Akta, NPWP, TDP, SIUP, dsb.
  ORGANIZATION_CHART // struktur organisasi
  KNOWLEDGE_ARTICLE // artikel/pengetahuan penguat KB klien
  // Legacy (backward-compat, deprecated — M2 menggantikan enum lama)
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum JournalStatus {
  DRAFT
  JUNIOR_REVIEW
  SENIOR_REVIEW
  TAX_REVIEW
  PARTNER_APPROVAL
  APPROVED
  FINALIZED // periode tutup buku — laporan disetujui partner, edit langsung dilarang
  EXCEPTION
  REJECTED
  ARCHIVED
}

enum JournalType {
  AI
  MANUAL
  ADJUSTING
}

enum ReviewStage {
  JUNIOR
  SENIOR
  TAX
  PARTNER
}

enum ReviewTaskStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlaStatus {
  MET
  AT_RISK
  BREACHED
}

// ── Entitas ──────────────────────────────────────────────────────────────

model Firm {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  clients             Client[]
  documents           Document[]
  journals            JournalEntry[]
  activities          ActivityLog[]
  slaEvents           SlaEvent[]
  fiscalPeriods       FiscalPeriod[]
  corrections         JournalCorrection[]
  outboxEvents        OutboxEvent[]
  reportSnapshots     ReportSnapshot[]
  clientNotifications ClientNotification[]
  fixedAssets         FixedAsset[]
  bankMutations       BankMutation[]
}

model User {
  id           String   @id @default(cuid())
  firmId       String
  email        String
  name         String
  role         Role
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm                Firm                @relation(fields: [firmId], references: [id])
  reviewTasks         ReviewTask[]        @relation("ReviewAssignee")
  corrections         JournalCorrection[] @relation("CorrectionUser")
  fiscalPeriodsLocked FiscalPeriod[]      @relation("PeriodLocker")

  @@unique([firmId, email])
  @@index([firmId, role])
}

model Client {
  id        String       @id @default(cuid())
  firmId    String
  name      String
  industry  Industry
  status    ClientStatus @default(ACTIVE)
  taxId     String? // NPWP
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  firm                Firm                 @relation(fields: [firmId], references: [id])
  documents           Document[]
  journals            JournalEntry[]
  fiscalPeriods       FiscalPeriod[]
  profile             ClientProfile?
  portalToken         ClientPortalToken?
  reportSnapshots     ReportSnapshot[]
  clientNotifications ClientNotification[]
  fixedAssets         FixedAsset[]
  bankMutations       BankMutation[]

  @@index([firmId, status])
}

model Document {
  id        String         @id @default(cuid())
  firmId    String
  clientId  String
  type      DocumentType
  mimeType  String
  fileName  String
  filePath  String
  fileHash  String
  sizeBytes Int
  status    DocumentStatus @default(PENDING)
  referenceText String? // F6C: teks hasil ekstraksi dokumen referensi (legalitas/org-chart/artikel KB)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  firm          Firm           @relation(fields: [firmId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  journals      JournalEntry[]
  bankMutations BankMutation[]

  @@index([firmId, clientId])
  @@index([status])
}

model JournalEntry {
  id            String        @id @default(cuid())
  firmId        String
  clientId      String
  documentId    String?
  assetId       String?
  status        JournalStatus @default(DRAFT)
  confidence    Float? // 0..1 — skor keyakinan AI
  description   String? // ringkasan transaksi
  exceptionFlag String? // mis. "Faktur PPN tidak ditemukan"
  createdByAi   Boolean       @default(true)
  journalType   JournalType   @default(AI) // AI = dari pipeline; MANUAL = input akuntan; ADJUSTING = jurnal penyesuaian
  entryDate     DateTime      @default(now()) // tanggal transaksi (untuk laporan per periode)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm                  Firm                   @relation(fields: [firmId], references: [id])
  client                Client                 @relation(fields: [clientId], references: [id])
  document              Document?              @relation(fields: [documentId], references: [id])
  asset                 FixedAsset?            @relation(fields: [assetId], references: [id])
  lines                 JournalLine[]
  reviewTask            ReviewTask[]
  activities            ActivityLog[]
  slaEvents             SlaEvent[]
  corrections           JournalCorrection[]
  depreciationSchedules DepreciationSchedule[]
  bankMutations         BankMutation[]

  @@index([firmId, status])
  @@index([firmId, clientId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountCode    String
  accountName    String
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  psakRef        String? // traceability: referensi PSAK
  notes          String?
  // F5B — kode pajak (KAP/KJS & jenis): override oleh tax specialist saat review.
  taxCode        String? // mis. "PPN-OUT-01", "PPH23-104", "PPH42-403", "PPH21-21-100-01"
  taxBase        Decimal? // DPP untuk PPh yang dipungut/dipotong @db.Decimal(18, 2)?

  // F6B — dimensi pelaporan (proyek/channel): { "project": "Proyek A", "channel": "Online" }
  dimension Json?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
}

// ══════════ F2.5E — Periode tutup buku (PRD M4/A5) ══════════
// Satu periode per klien; CLOSED = dikunci partner, edit langsung dilarang,
// hanya jurnal penyesuaian (ADJUSTING) yang boleh masuk setelahnya.
enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id         String             @id @default(cuid())
  firmId     String
  clientId   String
  period     String // "2026-08" (YYYY-MM)
  status     FiscalPeriodStatus @default(OPEN)
  lockedById String?
  lockedAt   DateTime?
  createdAt  DateTime           @default(now())

  firm     Firm   @relation(fields: [firmId], references: [id])
  client   Client @relation(fields: [clientId], references: [id])
  lockedBy User?  @relation("PeriodLocker", fields: [lockedById], references: [id])

  @@unique([clientId, period])
  @@index([firmId, status])
}

model ReviewTask {
  id             String           @id @default(cuid())
  journalEntryId String
  stage          ReviewStage
  assigneeId     String?
  status         ReviewTaskStatus @default(PENDING)
  urgent         Boolean          @default(false)
  dueAt          DateTime? // batas SLA stage
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime         @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ReviewAssignee", fields: [assigneeId], references: [id])

  @@index([journalEntryId, stage])
  @@index([assigneeId, status])
}

// ══════════ F2.5B — Koreksi jurnal saat review (feedback KB) ══════════
// Setiap perubahan baris jurnal oleh reviewer tercatat di sini → sumber data
// belajar KB (EN-03) + insight "akun paling sering dikoreksi" (A6).
model JournalCorrection {
  id             String      @id @default(cuid())
  firmId         String
  journalEntryId String
  userId         String?
  stage          ReviewStage
  field          String // "accountCode" | "accountName" | "debit" | "credit" | "notes"
  accountCode    String? // konteks akun yang dikoreksi (untuk insight A6)
  before         Json?
  after          Json?
  createdAt      DateTime    @default(now())

  firm         Firm         @relation(fields: [firmId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  user         User?        @relation("CorrectionUser", fields: [userId], references: [id])

  @@index([firmId, createdAt])
  @@index([journalEntryId])
  @@index([firmId, accountCode])
}

model ActivityLog {
  id             String   @id @default(cuid())
  firmId         String
  userId         String?
  journalEntryId String?
  action         String // mis. "AI_DRAFT_COMPLETED", "REVIEW_APPROVED", "EXCEPTION_FLAGGED"
  detail         Json?
  createdAt      DateTime @default(now())

  firm         Firm          @relation(fields: [firmId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([firmId, createdAt])
}

model SlaEvent {
  id             String      @id @default(cuid())
  firmId         String
  journalEntryId String?
  stage          ReviewStage
  targetMinutes  Int
  actualMinutes  Int?
  status         SlaStatus
  createdAt      DateTime    @default(now())

  firm         Firm          @relation(fields: [firmId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([firmId, status])
}

// ══════════ EN-01 — Knowledge Platform (F2) ══════════
// KB hidup: versioned, tanggal efektif, workflow approval Senior/Partner.
// Menggantikan referensi statis di src/ai/knowledge/ (TD-07).

enum KnowledgeStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REJECTED
}

model KnowledgeItem {
  id            String          @id @default(cuid())
  category      String // "COA" | "Peraturan Pajak" | "Template Jurnal" | ...
  name          String // slug unik per kategori, mis. "coa-retail"
  title         String
  content       String
  version       Int             @default(1)
  effectiveDate DateTime // aturan berlaku sejak kapan (jurnal lama tetap valid)
  status        KnowledgeStatus @default(DRAFT)
  changeNote    String? // alasan perubahan (audit trail)
  approvedById  String?
  approvedAt    DateTime?
  supersedesId  String?         @unique
  supersedes    KnowledgeItem?  @relation("VersionChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions     KnowledgeItem[] @relation("VersionChain")
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([category, name, version])
  @@index([category, name, status])
  @@index([effectiveDate])
}

// ══════════ EN-02 — Client Profile (F2) ══════════
// Klien dengan COA/laporan baku langsung dikenali AI saat upload.

enum ProfileStatus {
  NONE
  LEARNING
  REVIEW
  READY
}

model ClientProfile {
  id              String        @id @default(cuid())
  clientId        String        @unique
  firmId          String
  // Mapping COA klien → COA standar: { "kodeKlien": { "accountCode": "1101", "accountName": "Kas" } }
  coaMapping      Json          @default("{}")
  // Template laporan klien: { "labarugi": "...", "neraca": "..." }
  reportTemplates Json          @default("{}")
  // Aturan spesifik klien: { "penyusutan": "...", "kebijakan": "..." }
  rules           Json          @default("{}")
  mappingStatus   ProfileStatus @default(NONE)
  sourcePeriod    String? // periode historis yang dipelajari, mis. "2026-01"
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId])
}

// ══════════ EN-08 — Portal Klien (F2) ══════════
// Klien mengakses lewat token unik (tanpa login), upload mandiri,
// lihat laporan & status dokumen. Token bisa di-reset oleh firma.

model ClientPortalToken {
  id        String   @id @default(cuid())
  clientId  String   @unique
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ══════════ F3 — Portal Klien (K1–K6) ══════════
// ReportSnapshot: versi laporan per periode (K5/A1) — dibuat saat periode dikunci,
// bisa diunduh klien kapan saja. ClientNotification: notifikasi proaktif (K4).
model ReportSnapshot {
  id          String   @id @default(cuid())
  firmId      String
  clientId    String
  period      String // "2026-08"
  type        String // "TRIAL_BALANCE" | "JOURNALS" | "ANNUAL_REPORT"
  status      ReportSnapshotStatus @default(DRAFT)
  version     Int      @default(1)
  payload     Json
  notes       String?
  createdById String?
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?
  deliveredAt  DateTime?
  createdAt   DateTime @default(now())

  firm   Firm   @relation(fields: [firmId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, period, type, version])
  @@index([clientId, period])
}

model ClientNotification {
  id        String    @id @default(cuid())
  firmId    String
  clientId  String
  type      String // "REPORT_READY" | "DOCUMENT_PROCESSED" | "EXCEPTION" | "REMINDER"
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  firm   Firm   @relation(fields: [firmId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, readAt])
}

// ══════════ F5A — Aset Tetap (M8) ══════════
enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

model FixedAsset {
  id                   String             @id @default(cuid())
  firmId               String
  clientId             String
  name                 String
  category             String // "Kendaraan", "Peralatan", "Bangunan", dst.
  purchaseDate         DateTime // tanggal perolehan
  purchaseCost         Decimal // biaya perolehan (rupiah)
  residualValue        Decimal // nilai sisa komersial
  method               DepreciationMethod @default(STRAIGHT_LINE)
  commercialLifeMonths Int // umur komersial (PSAK 216)
  fiscalGroup          String // Pasal 11: "K1"|"K2"|"K3"|"K4"|"BP"|"BNP"
  notes                String?
  status               FixedAssetStatus   @default(ACTIVE)
  disposedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  firm      Firm                   @relation(fields: [firmId], references: [id])
  client    Client                 @relation(fields: [clientId], references: [id])
  schedules DepreciationSchedule[]
  journals  JournalEntry[]

  @@index([firmId, clientId])
}

model DepreciationSchedule {
  id                    String   @id @default(cuid())
  assetId               String
  period                String // "2026-08"
  commercialAmount      Decimal // penyusutan komersial bulan ini
  fiscalAmount          Decimal // penyusutan fiskal bulan ini
  accumulatedCommercial Decimal // akumulasi komersial s.d. periode
  accumulatedFiscal     Decimal // akumulasi fiskal s.d. periode
  bookValueCommercial   Decimal // nilai buku komersial akhir periode
  bookValueFiscal       Decimal // nilai buku fiskal akhir periode
  journalEntryId        String?
  createdAt             DateTime @default(now())

  asset        FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([assetId, period])
  @@index([period])
}

// ══════════ F6A — Rekonsiliasi Bank (M6) ══════════
// Baris mutasi bank per klien-periode; di-match-kan ke jurnal kas (1-1000/1-1100).
enum ReportSnapshotStatus {
  DRAFT       @map("draft")
  IN_REVIEW   @map("in_review")
  APPROVED    @map("approved")
  DELIVERED   @map("delivered")
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  MANUAL
}

model BankMutation {
  id               String          @id @default(cuid())
  firmId           String
  clientId         String
  period           String // "2026-08"
  date             DateTime
  description      String
  amount           Decimal // + masuk, - keluar @db.Decimal(18, 2)
  documentId       String?
  matchedJournalId String?
  matchStatus      BankMatchStatus @default(UNMATCHED)
  matchScore       Float?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  firm           Firm          @relation(fields: [firmId], references: [id])
  client         Client        @relation(fields: [clientId], references: [id])
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  matchedJournal JournalEntry? @relation(fields: [matchedJournalId], references: [id], onDelete: SetNull)

  @@index([firmId, clientId, period])
}

// ══════════ EN-05 — Outbox Persistence (F2) ══════════
// Outbox pattern: event domain ditulis ke tabel, consumer baca & proses.
// Menjamin at-least-once delivery; webhook/email dibangun di atas ini.

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id           String       @id @default(cuid())
  firmId       String? // tenant pemilik event (nullable utk data legacy; wajib di create baru)
  clientId     String? // klien terkait event, bila ada
  eventType    String // "journalApproved" | "journalException" | "slaBreach"
  payload      Json
  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0)
  maxRetries   Int          @default(3)
  lastError    String?
  processAfter DateTime     @default(now()) // delay retry eksponensial
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  firm          Firm?             @relation(fields: [firmId], references: [id])
  notifications NotificationLog[]

  @@index([firmId, status])
  @@index([status, processAfter])
  @@index([eventType])
}

// ══════════ EN-05 — Webhook & Notification (F2) ══════════
// Firma mendaftarkan URL webhook untuk menerima notifikasi event.
// Event diproses via consumer worker → POST ke webhook URL.

model WebhookSubscription {
  id         String   @id @default(cuid())
  firmId     String
  url        String // endpoint webhook firma
  secret     String? // HMAC secret untuk verifikasi signature
  eventTypes String[] // ["journalApproved", "slaBreach", ...]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notifications NotificationLog[]

  @@index([firmId, enabled])
}

model NotificationLog {
  id         String   @id @default(cuid())
  outboxId   String? // relasi ke OutboxEvent
  webhookId  String?
  status     String   @default("SENT") // SENT | FAILED
  statusCode Int? // HTTP response code
  response   String? // body response
  error      String?
  sentAt     DateTime @default(now())

  outboxEvent OutboxEvent?         @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  webhook     WebhookSubscription? @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  @@index([outboxId])
  @@index([sentAt])
}
