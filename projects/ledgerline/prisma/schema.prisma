// LedgerLine — Data model (v1)
// Konvensi: snake_case kolom; semua tabel multi-tenant punya firmId (tenant-aware).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  JUNIOR
  SENIOR
  TAX
  PARTNER
}

enum Industry {
  RETAIL
  SERVICES
  FNB
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  INVOICE
  BANK_STATEMENT
  RECEIPT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum JournalStatus {
  DRAFT
  JUNIOR_REVIEW
  SENIOR_REVIEW
  TAX_REVIEW
  PARTNER_APPROVAL
  APPROVED
  EXCEPTION
  REJECTED
  ARCHIVED
}

enum ReviewStage {
  JUNIOR
  SENIOR
  TAX
  PARTNER
}

enum ReviewTaskStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlaStatus {
  MET
  AT_RISK
  BREACHED
}

// ── Entitas ──────────────────────────────────────────────────────────────

model Firm {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  clients    Client[]
  documents  Document[]
  journals   JournalEntry[]
  activities ActivityLog[]
  slaEvents  SlaEvent[]
}

model User {
  id           String   @id @default(cuid())
  firmId       String
  email        String
  name         String
  role         Role
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm         Firm         @relation(fields: [firmId], references: [id])
  reviewTasks  ReviewTask[] @relation("ReviewAssignee")

  @@unique([firmId, email])
  @@index([firmId, role])
}

model Client {
  id        String       @id @default(cuid())
  firmId    String
  name      String
  industry  Industry
  status    ClientStatus @default(ACTIVE)
  taxId     String? // NPWP
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  firm      Firm        @relation(fields: [firmId], references: [id])
  documents Document[]
  journals  JournalEntry[]

  @@index([firmId, status])
}

model Document {
  id          String         @id @default(cuid())
  firmId      String
  clientId    String
  type        DocumentType
  mimeType    String
  fileName    String
  filePath    String
  fileHash    String
  sizeBytes   Int
  status      DocumentStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  firm     Firm           @relation(fields: [firmId], references: [id])
  client   Client         @relation(fields: [clientId], references: [id])
  journals JournalEntry[]

  @@index([firmId, clientId])
  @@index([status])
}

model JournalEntry {
  id            String        @id @default(cuid())
  firmId        String
  clientId      String
  documentId    String?
  status        JournalStatus @default(DRAFT)
  confidence    Float? // 0..1 — skor keyakinan AI
  description   String? // ringkasan transaksi
  exceptionFlag String? // mis. "Faktur PPN tidak ditemukan"
  createdByAi   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm       Firm          @relation(fields: [firmId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id])
  document   Document?     @relation(fields: [documentId], references: [id])
  lines      JournalLine[]
  reviewTask ReviewTask[]
  activities ActivityLog[]
  slaEvents  SlaEvent[]

  @@index([firmId, status])
  @@index([firmId, clientId])
}

model JournalLine {
  id            String        @id @default(cuid())
  journalEntryId String
  accountCode   String
  accountName   String
  debit         Decimal       @default(0) @db.Decimal(18, 2)
  credit        Decimal       @default(0) @db.Decimal(18, 2)
  psakRef       String? // traceability: referensi PSAK
  notes         String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
}

model ReviewTask {
  id            String           @id @default(cuid())
  journalEntryId String
  stage         ReviewStage
  assigneeId    String?
  status        ReviewTaskStatus @default(PENDING)
  urgent        Boolean          @default(false)
  dueAt         DateTime? // batas SLA stage
  reviewedAt    DateTime?
  note          String?
  createdAt     DateTime         @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ReviewAssignee", fields: [assigneeId], references: [id])

  @@index([journalEntryId, stage])
  @@index([assigneeId, status])
}

model ActivityLog {
  id             String   @id @default(cuid())
  firmId         String
  userId         String?
  journalEntryId String?
  action         String // mis. "AI_DRAFT_COMPLETED", "REVIEW_APPROVED", "EXCEPTION_FLAGGED"
  detail         Json?
  createdAt      DateTime @default(now())

  firm         Firm          @relation(fields: [firmId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([firmId, createdAt])
}

model SlaEvent {
  id              String    @id @default(cuid())
  firmId          String
  journalEntryId  String?
  stage           ReviewStage
  targetMinutes   Int
  actualMinutes   Int?
  status          SlaStatus
  createdAt       DateTime  @default(now())

  firm         Firm          @relation(fields: [firmId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([firmId, status])
}
