# Salin ke .env untuk pengembangan lokal. JANGAN commit .env asli.

# Database (PostgreSQL) — Task 2
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerline"

# Queue pipeline (Redis) — Task 6
REDIS_URL="redis://localhost:6379"

# Autentikasi — Task 3 (generate: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-random-string"

# Password akun demo (seed). Default "password123" HANYA untuk dev lokal.
# Produksi wajib set nilai kuat, lalu rehash: npx tsx prisma/reset-demo-password.ts
DEMO_PASSWORD="password123"

# LLM Engine (F2) — primary GLM (Zhipu AI), OpenAI-compatible.
# ⚠️ Model per platform:
#   z.ai (internasional)   → teks: glm-4.5-air · vision: glm-4.5 · kuat: glm-4.6 (berbayar, saldo)
#   bigmodel.cn (China)    → teks: glm-4-flash · vision: glm-4v-flash (GRATIS) · kuat: glm-4.6
# Ambil API key di https://z.ai (atau https://open.bigmodel.cn untuk flash gratis).
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
# Model routing: teks / vision-OCR / retry kualitas
LLM_MODEL="glm-4.5-air"
LLM_VISION_MODEL="glm-4.5"
LLM_STRONG_MODEL="glm-4.6"
# Backward-compat: LLM_API_KEY/LLM_BASE_URL tetap dibaca kalau GLM_* kosong.
# Lokal (opsional): GLM_BASE_URL="http://localhost:11434/v1" LLM_MODEL="qwen2.5:14b"

# Pipeline worker (Task 6): jalankan `npm run worker` di terminal terpisah.
# Redis harus berjalan (brew services start redis).
# Kunci enkripsi at-rest dokumen (AES-256-GCM, hex 64 karakter). WAJIB di
# produksi; tanpa ini aplikasi memakai kunci DEV (tidak aman).
# Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
# Kunci LAMA saat rotasi (F-3) — pisah koma. Untuk dekripsi data yang belum
# di-re-encrypt. Hapus setelah rotasi selesai (lihat infra/key-rotation.md).
STORAGE_ENCRYPTION_KEY_PREVIOUS=

# Storage driver (F-1): filesystem (default, dev/demo) | s3 (R2/S3/MinIO).
STORAGE_DRIVER=filesystem
# S3-compatible (hanya saat STORAGE_DRIVER=s3):
#   R2     → S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com · S3_REGION=auto
#   MinIO  → S3_ENDPOINT=http://localhost:9000 · S3_FORCE_PATH_STYLE=true
#   AWS S3 → kosongkan S3_ENDPOINT, isi S3_REGION (mis. ap-southeast-1)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Email Notification (TD-14) ──
# noop = log ke console (dev), resend = Resend API (cloud)
EMAIL_PROVIDER=noop
EMAIL_FROM=noreply@praktis.id
# RESEND_API_KEY=re_xxxxx
# ── URL Aplikasi (untuk link di email) ──
APP_URL=http://localhost:3000
